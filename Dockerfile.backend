FROM python:3.11-slim

WORKDIR /app

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

# Install CPU PyTorch first to prevent downloading 3+ GB of CUDA packages
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu

# Copy project configuration and code
COPY pyproject.toml README.md* LICENSE* ./
COPY neurostage/ ./neurostage/
COPY backend/ ./backend/
COPY configs/ ./configs/

# Install Python backend dependencies
RUN pip install --no-cache-dir ".[backend]"

# Create unprivileged application user and ensure permissions on runtime directories
RUN useradd -m -u 10001 -s /bin/bash appuser && \
    mkdir -p /app/runs/checkpoints /app/uploads /app/data/processed && \
    chmod -R 777 /app/runs /app/uploads /app/data && \
    chown -R appuser:appuser /app

ENV PYTHONPATH=/app

USER appuser

EXPOSE 8000

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
