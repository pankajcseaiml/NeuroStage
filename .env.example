# NeuroStage Environment Variables
# Copy this to .env and fill in production values. NEVER commit .env to git.

# ── Security ──────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme_generate_a_strong_random_key_before_deploying

# ── Database ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://neurostage:neurostage@localhost:5432/neurostage

# ── MLflow ────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# ── ML Model ─────────────────────────────────────────────────────
MODEL_CHECKPOINT=runs/checkpoints/neurostage_base_best.pt
MODEL_CONFIG_PATH=configs/base.yaml

# ── File Uploads ──────────────────────────────────────────────────
UPLOAD_DIR=uploads/
MAX_UPLOAD_SIZE_MB=500

# ── CORS (adjust for your domain in production) ───────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ── Frontend ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
